<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Локальная настройка источников пакетов.
    С машины недоступен https://api.nuget.org, поэтому используется
    публичное зеркало dotnet-public (оно повторяет nuget.org).
    На обычной машине файл можно удалить: восстановление пойдёт с nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" protocolVersion="3" />
    <add key="microsoft-visual-studio-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages" />
  </packageSources>
</configuration>
